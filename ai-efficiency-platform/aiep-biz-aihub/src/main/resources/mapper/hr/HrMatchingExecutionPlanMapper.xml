<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aiep.aihub.repository.hr.HrMatchingExecutionPlanMapper">
<select id="find" resultType="com.aiep.aihub.repository.hr.HrMatchingExecutionPlanMapper$Row">SELECT tenant_id,scope_ref AS scope,run_id,payload FROM ai_hr_matching_execution_plan WHERE tenant_id=#{tenant} AND scope_ref=#{scope}</select>
<insert id="insert">INSERT INTO ai_hr_matching_execution_plan(tenant_id,scope_ref,run_id,payload) VALUES(#{tenantId},#{scope},#{runId},#{payload})</insert>
</mapper>
