{
  "name": "ai-efficiency-platform-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=20.18.0 <21 || >=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "vue-tsc --noEmit --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "preview:release": "node scripts/serve-dist.mjs",
    "test:e2e:release": "playwright test --config playwright.release.config.ts"
  },
  "dependencies": {
    "@ant-design/icons-vue": "7.0.1",
    "ant-design-vue": "4.2.6",
    "axios": "1.20.0",
    "markdown-it": "14.1.0",
    "pinia": "3.0.4",
    "vue": "3.5.26",
    "vue-router": "4.6.4",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.6",
    "@testing-library/vue": "8.1.0",
    "@types/markdown-it": "14.1.2",
    "@types/node": "26.4.0",
    "@vitejs/plugin-vue": "5.2.4",
    "@vitest/coverage-v8": "4.1.11",
    "@vue/test-utils": "2.4.6",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.5.1",
    "globals": "17.11.0",
    "jsdom": "26.1.0",
    "msw": "2.15.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "6.3.5",
    "vitest": "4.1.11",
    "vue-tsc": "3.1.4"
  }
}
