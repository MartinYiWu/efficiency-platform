+    assert [item.event for item in resumed].count("stream_done") == 1
+
+
+@pytest.mark.asyncio
+async def test_v1_delivery_remains_compatible_with_the_existing_event_name() -> None:
+    """显式 V1 Run 仍使用同一个 deliverable 事件，不引入第二套协议。"""
