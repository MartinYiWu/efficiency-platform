"""从已核验快照构建不丢证据的结构化交付包。"""

from __future__ import annotations

import hashlib

from efficiency_platform_agent.contracts.research_evidence_v2 import (
    ClaimRecordV2,
    EvidenceSnapshotV2,
)
from efficiency_platform_agent.contracts.research_v2 import (
    DeliveryCitationV2,
    DeliveryEventV2,
    DeliveryPackV2,
    ResearchBriefV2,
    ResearchOutcomeV2,
)


class DeliveryPackBuilder:
    def build(
        self,
        brief: ResearchBriefV2,
        outcome: ResearchOutcomeV2,
        evidence_snapshot: EvidenceSnapshotV2,
    ) -> DeliveryPackV2:
        digest = brief.canonical_digest()
        if evidence_snapshot.brief_digest != digest:
            raise ValueError("DELIVERY_BRIEF_SNAPSHOT_MISMATCH")
        if outcome.outcome == "FAILED":
            raise ValueError("DELIVERY_UNAVAILABLE")
        usable = tuple(dict.fromkeys(outcome.usable_event_ids))
        events_by_id = {item.event_id: item for item in evidence_snapshot.events}
        claims_by_event: dict[str, list[ClaimRecordV2]] = {}
        for claim in evidence_snapshot.claims:
            if claim.event_id in usable and not (
                claim.assertion_mode == "objective"
                and claim.conflict_status == "unresolved"
            ):
                claims_by_event.setdefault(claim.event_id, []).append(claim)
        refs = {item.evidence_id: item for item in evidence_snapshot.evidence_refs}
        documents = {item.document_id: item for item in evidence_snapshot.documents}
        structured: list[DeliveryEventV2] = []
        for event_id in usable:
            event = events_by_id.get(event_id)
            if event is None:
                raise ValueError("DELIVERY_EVENT_UNKNOWN")
            claims = claims_by_event.get(event_id, [])
            if not claims:
                raise ValueError("DELIVERY_EVENT_WITHOUT_CLAIMS")
            citations: dict[str, DeliveryCitationV2] = {}
            for claim in claims:
                for ref_id in claim.support_refs:
                    ref = refs.get(ref_id)
                    document = documents.get(ref.document_id) if ref else None
                    if ref is None or document is None:
                        raise ValueError("DELIVERY_CITATION_BROKEN")
                    citations[ref_id] = DeliveryCitationV2(
                        evidence_id=ref.evidence_id,
                        document_id=document.document_id,
                        url=document.canonical_url,
                        title=document.title,
                        publisher_id=document.publisher_id,
                        source_role=document.source_role,
                        excerpt=ref.excerpt,
                    )
            representative = documents.get(event.representative_document_id)
            if representative is None:
                raise ValueError("DELIVERY_REPRESENTATIVE_UNKNOWN")
            structured.append(
                DeliveryEventV2(
                    event_id=event_id,
                    title=representative.title,
                    event_time=event.event_time,
                    claim_ids=tuple(item.claim_id for item in claims),
                    claim_texts=tuple(item.text for item in claims),
                    citations=tuple(citations[key] for key in sorted(citations)),
                )
            )
        if outcome.outcome == "NO_MATCHES" and structured:
            raise ValueError("DELIVERY_NO_MATCHES_HAS_EVENTS")
        if outcome.outcome in {"COMPLETE", "PARTIAL"} and not structured:
            raise ValueError("DELIVERY_EVENTS_REQUIRED")
        time_label = (
            f"{brief.time_window.start.isoformat()}—{brief.time_window.end.isoformat()}，"
            f"{brief.time_window.timezone}"
        )
        gap_codes = tuple(item.code for item in outcome.gaps)
        content = _deterministic_summary(
            outcome.outcome,
            time_label,
            len(structured),
            brief.count_policy.target,
            gap_codes,
            outcome.stop_reason,
        )
        event_ids = tuple(item.event_id for item in structured)
        claim_ids = tuple(
            claim_id for item in structured for claim_id in item.claim_ids
        )
        evidence_ids = tuple(
            dict.fromkeys(
                citation.evidence_id
                for item in structured
                for citation in item.citations
            )
        )
        delivery_id = (
            "delivery-"
            + hashlib.sha256(
                (
                    digest
                    + "\x00"
                    + outcome.stop_reason
                    + "\x00"
                    + "\x00".join(event_ids)
                ).encode()
            ).hexdigest()[:32]
        )
        return DeliveryPackV2(
            delivery_id=delivery_id,
            brief_digest=digest,
            event_ids=event_ids,
            claim_ids=claim_ids,
            evidence_ids=evidence_ids,
            outcome=outcome.outcome,
            display_status=(
                "succeeded"
                if outcome.outcome in {"COMPLETE", "NO_MATCHES"}
                else "degraded_succeeded"
            ),
            stop_reason=outcome.stop_reason,
            requested_count=brief.count_policy.target,
            delivered_event_count=len(structured),
            time_window_label=time_label,
            events=tuple(structured),
            gap_codes=gap_codes,
            content=content,
            limitations=tuple(item.detail for item in outcome.gaps),
            renderer_version="research-markdown/2.0.0",
        )


def _deterministic_summary(
    outcome: str,
    time_label: str,
    delivered: int,
    requested: int,
    gaps: tuple[str, ...],
    stop_reason: str,
) -> str:
    lines = [
        f"研究范围：{time_label}。",
        f"已核对 {delivered} 条符合条件的不同事件；原要求 {requested} 条。",
    ]
    if gaps:
        lines.append("未满足项：" + "、".join(gaps) + "。")
    lines.append(f"停止原因：{stop_reason}。")
    lines.append("以下结论仅代表已检查且通过证据门禁的来源范围。")
    if outcome == "NO_MATCHES":
        lines.append("在已声明的检查范围内未发现符合条件的事件。")
    return "\n".join(lines)


__all__ = ["DeliveryPackBuilder"]
