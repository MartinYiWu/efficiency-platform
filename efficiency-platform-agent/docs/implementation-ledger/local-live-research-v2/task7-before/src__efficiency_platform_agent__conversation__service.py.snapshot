}
_DEFAULT_LATEST_TIME_WINDOW = "最近7天（默认最新信息窗口）"
_UNBOUNDED_RESEARCH_TIME_WINDOW = "未限定时间范围（公开资料核验）"
_GENERIC_RESEARCH_REFERENCES = frozenset(
